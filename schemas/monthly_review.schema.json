{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Monthly review",
  "type": "object",
  "required": ["month", "pillars_reviewed", "portfolio_action_required"],
  "properties": {
    "month": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}$"
    },
    "pillars_reviewed": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "portfolio_action_required": {
      "type": "boolean"
    }
  },
  "additionalProperties": true
}

