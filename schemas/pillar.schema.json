{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Thesis pillar",
  "type": "object",
  "required": ["id", "title", "claim", "falsification", "created", "status"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "falsification": {
      "type": "string",
      "minLength": 1
    },
    "created": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "status": {
      "type": "string",
      "enum": ["active", "weakened", "invalidated", "retired"]
    }
  },
  "additionalProperties": true
}

